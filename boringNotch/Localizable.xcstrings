    "Boring Notch" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch"
          }
        }
      }
    },
    "Boring Notch can analyze the audio playing from your music app to draw a live FFT waveform in the notch, with only a minimal impact on CPU usage." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch peut analyser la lecture audio depuis votre application musicale pour animer dans l'encoche la forme d'onde FFT en temps réel, avec un impact minimal sur l'utilisation du processeur."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch может анализировать воспроизведение звука из вашего музыкального приложения, чтобы нарисовать форму звука живого FFT в вырезе, при минимальном влиянии на использование ЦП."
          }
        }
      }
    },
    "Boring Notch can check for updates in the background. You can still check manually from the menu bar at any time." : {
      "comment" : "A description of the software update permission.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch kann im Hintergrund nach Updates suchen. Sie können jederzeit auch manuell über die Menüleiste nach Updates suchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch puede comprobar si hay actualizaciones en segundo plano. Puede comprobar manualmente desde la barra del menú en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch peut vérifier les mises à jour en arrière-plan. Vous pouvez toujours vérifier manuellement à partir de la barre de menus à tout moment."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch может проверить наличие обновлений в фоновом режиме. Вы все еще можете вручную проверить в строке меню в любое время."
          }
        }
      }
    },
    "Boring Notch can show all your upcoming events in one place. Access to your calendar is needed to display your schedule." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch peut afficher tous vos événements à venir en un seul endroit. L'accès à votre calendrier est nécessaire pour afficher votre planning."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch может показать все ваши предстоящие события в одном месте. Доступ к календарю необходим для отображения вашего графика."
          }
        }
      }
    },
    "Boring Notch can show your scheduled reminders alongside your calendar events. Access to Reminders is needed to display your reminders." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch peut afficher vos rappels programmés à côté des événements de votre calendrier. L'accès aux rappels est nécessaire pour afficher vos rappels."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch может отображать ваши запланированные напоминания вместе с событиями календаря. Доступ к Напоминаниям необходим для их отображения."
          }
        }
      }
    },
    "Boring Notch could not verify Now Playing. Try again, or reopen the app if it keeps happening." : {
      "comment" : "Recoverable Now Playing probe failure message.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch could not verify Now Playing. Try again, or reopen the app if it keeps happening."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch no pudo verificar la Reproduciendo Ahora. Inténtalo de nuevo o vuelve a abrir la aplicación si sigue sucediendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch n'a pas pu vérifier « À l'écoute ». Essayez à nouveau, ou rouvrez l'application si cela continue de se produire."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch не смог проверить воспроизведение. Попробуйте еще раз или перезапустите приложение, если это повторится."
          }
        }
      }
    },
    "Boring Notch includes a mirror feature that lets you quickly check your appearance using your camera, right from the notch. Camera access is required only to show this live preview. You can turn the mirror feature on or off at any time in the app." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch comprend une fonction de miroir qui vous permet de vérifier rapidement votre apparence à l'aide de votre caméra, directement depuis l'encoche. L'accès à la caméra n'est nécessaire que pour afficher cet aperçu en direct. Vous pouvez activer ou désactiver la fonction miroir à tout moment dans l'application."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Boring Notch имеется зеркало, которое позволяет быстро проверить ваш внешний вид с помощью вашей камеры прямо в вырезе. Доступ к камере требуется только для отображения этого предварительного просмотра в реальном времени. Вы можете включить или выключить функцию зеркала в любое время в приложении."
          }
        }
      }
    },
    "Boring Notch lost its Now Playing connection. Reconnecting automatically..." : {
      "comment" : "Now Playing runtime failure message shown before an automatic recovery attempt.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch lost its Now Playing connection. Reconnecting automatically..."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch perdió la conexión con la Reproduciendo Ahora. Reconectando automáticamente..."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch a perdu le lien avec « À l'écoute ». Reconnexion en cours..."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boring Notch потерял соединение с воспроизведением. Автоматическое переподключение..."
          }
        }
      }
    },
