    },
    "'Now Playing' was the only option on previous versions and works with all media apps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Jetzt läuft\" war die einzige Option auf vorherigen Versionen und funktioniert mit allen Medien-Apps."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Now Playing' was the only option on previous versions and works with all media apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Ahora suena\" era la única opción disponible en versiones anteriores y funciona con todas las aplicaciones multimedia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« À l'écoute » était la seule option des versions précédentes et fonctionne avec toutes les applications multimédias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Сейчас играть' была единственной опцией в предыдущих версиях и работает со всеми медиа-приложениями."
          }
        }
      }
    },
    "(%@)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(%@)"
          }
        }
      }
    },
    "%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@"
          }
        }
      }
    },
    "%@ is only needed when using built-in macOS control sources for OSD replacement. External sources like BetterDisplay or Lunar do not require it. You can enable it later in OSD settings if needed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird nur benötigt, wenn eingebaute macOS-Steuerungsquellen für den OSD-Austausch verwendet werden. Externe Quellen wie BetterDisplay oder Lunar benötigen es nicht. Sie können es später in den OSD-Einstellungen aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is only needed when using built-in macOS control sources for OSD replacement. External sources like BetterDisplay or Lunar do not require it. You can enable it later in OSD settings if needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Solo es necesario cuando se usan fuentes de control macOS incorporadas para el reemplazo de OSD. Fuentes externas como BetterDisplay o Lunar no lo requieren. Puedes activarlo más tarde en ajustes OSD si es necesario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'est nécessaire pour le remplacement de l'OSD que lorsque vous utilisez la gestion native de macOS.\nLes sources externes telles que BetterDisplay ou Lunar ne la requièrent pas. Vous pouvez l'activer ultérieurement dans les paramètres de l'OSD si nécessaire."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ необходим только при использовании встроенных источников управления macOS для замены OSD. Внешние источники, такие как BetterDisplay или Lunar не требуются. Вы можете включить его позже в настройках OSD."
          }
        }
      }
    },
    "%@ is used only to improve media and brightness notifications. No data is collected or shared." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is used only to improve media and brightness notifications. No data is collected or shared."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Se utiliza solo para mejorar las notificaciones de brillo y multimedia. No se recopilan ni comparten datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sert uniquement à améliorer les notifications relatives aux médias et à la luminosité. Aucune donnée n'est collectée ni partagée."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ используется только для улучшения уведомлений о медиа и яркости. Данные не собираются и не передаются."
          }
        }
      }
    },
